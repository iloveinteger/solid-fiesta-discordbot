# Discord Developer Portal에서 발급한 봇 토큰 (필수)
DISCORD_BOT_TOKEN=
# Discord 애플리케이션 ID (필수)
DISCORD_APPLICATION_ID=
# 표준국어대사전 Open API 인증 키 (필수)
STDICT_API_KEY=
# 개발 서버에 명령어를 즉시 등록할 때만 서버 ID 입력 (선택)
DISCORD_GUILD_ID=
# 제한된 Python 실행 기능 활성화 여부 (기본값: true)
ENABLE_PYTHON_RUNNER=true
# SQLite 파일 경로 (선택, 기본값: ./data/bot.sqlite)
DATABASE_PATH=./data/bot.sqlite
# 격리 실행용 Docker 이미지 이름 (선택)
PYTHON_RUNNER_IMAGE=solid-fiesta-python-runner:latest
# Linux에서 /var/run/docker.sock의 그룹 ID (선택, 기본값: 999)
DOCKER_GID=999
