# Discord Developer Portal에서 발급한 봇 토큰 (필수)
DISCORD_BOT_TOKEN=
# Discord 애플리케이션 ID (필수)
DISCORD_APPLICATION_ID=
# 표준국어대사전 Open API 인증 키 (필수)
STDICT_API_KEY=
# Google AI Studio에서 발급한 Gemini API 키 (/ask 전용, 선택)
GEMINI_API_KEY=
# Gemini 모델 ID (선택, 기본값: gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash
# 개발 서버에 명령어를 즉시 등록할 때만 서버 ID 입력 (선택)
DISCORD_GUILD_ID=
